{
  "name": "hexaduck",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler d1 migrations apply hexaduck --remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply hexaduck --local",
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@playwright/test": "^1.63.0",
    "typescript": "^7.0.2",
    "vitest": "~4.1",
    "wrangler": "^4.138.0"
  }
}
