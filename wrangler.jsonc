{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hexaduck",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Only the API goes through the Worker; everything else is served straight from the asset store.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hexaduck",
      // Replace with the id printed by `npx wrangler d1 create hexaduck`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
